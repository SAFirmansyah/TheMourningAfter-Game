[layer_names]

3d_physics/layer_1="world_bounds"
3d_physics/layer_2="environment"
3d_physics/layer_3="player"
3d_physics/layer_4="enemies"
3d_physics/layer_5="hitbox"
3d_physics/layer_6="player_hurtbox"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_8="mob_barrier"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"

[shader_globals]

occlusion_target={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
