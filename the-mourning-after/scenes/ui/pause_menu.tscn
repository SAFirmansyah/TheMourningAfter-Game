[gd_scene format=3]

[ext_resource type="Texture2D" path="res://textures/short title.png" id="t_short"]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Shader" path="res://shaders/grayscale_overlay.gdshader" id="2_gray"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_gray"]
shader = ExtResource("2_gray")
shader_parameter/amount = 0.0
shader_parameter/darken = 0.55

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 70.0
content_margin_right = 70.0
bg_color = Color(0.06, 0.06, 0.07, 0.96)
border_width_right = 4
border_color = Color(0.78, 0.66, 0.38, 1)
shadow_color = Color(0, 0, 0, 0.5)
