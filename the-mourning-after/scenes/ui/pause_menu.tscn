anchor_right = 0.3333
anchor_bottom = 1.0
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Content" type="VBoxContainer" parent="Panel"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="Title" type="TextureRect" parent="Panel/Content"]
custom_minimum_size = Vector2(300, 209)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
