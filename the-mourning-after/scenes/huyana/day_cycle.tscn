[node name="NightModal" type="CanvasLayer" parent="."]
layer = 6

[node name="Panel" type="PanelContainer" parent="NightModal"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -510.0
offset_top = -244.0
offset_right = 510.0
offset_bottom = 244.0
grow_horizontal = 2
grow_vertical = 2
