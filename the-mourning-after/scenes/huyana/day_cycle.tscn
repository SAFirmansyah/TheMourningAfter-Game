[sub_resource type="ShaderMaterial" id="ShaderMaterial_night"]
shader = ExtResource("3_night")
shader_parameter/amount = 0.0

[sub_resource type="ButtonGroup" id="ButtonGroup_speed"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_speed"]
content_margin_top = 4.0
content_margin_bottom = 4.0
bg_color = Color(0.08, 0.08, 0.09, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
