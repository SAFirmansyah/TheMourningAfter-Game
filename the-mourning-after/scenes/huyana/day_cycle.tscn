[gd_scene format=3]

[ext_resource type="FontFile" path="res://fonts/IMFellGreatPrimerSC-Regular.ttf" id="f_title"]

[ext_resource type="Texture2D" path="res://textures/ui/Clock.png" id="90_clockface"]
[ext_resource type="Texture2D" path="res://textures/ui/clock_hand.png" id="91_clockhand"]
[ext_resource type="Script" path="res://scripts/huyana/day_cycle.gd" id="1_cycle"]
