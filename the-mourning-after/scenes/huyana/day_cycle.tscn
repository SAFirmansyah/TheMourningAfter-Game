theme_override_colors/font_color = Color(0.24, 0.15, 0.09, 1)
theme_override_font_sizes/font_size = 32
text = "Sanctuary Health"
horizontal_alignment = 1

[node name="HealthBar" type="TextureProgressBar" parent="NightModal/Panel/Content"]
custom_minimum_size = Vector2(696, 70)
layout_mode = 2
size_flags_horizontal = 4
value = 100.0
nine_patch_stretch = true
texture_under = ExtResource("5_bar_bg")
texture_progress = ExtResource("6_bar")

[node name="Percent" type="Label" parent="NightModal/Panel/Content/HealthBar"]
layout_mode = 1
anchors_preset = 15
