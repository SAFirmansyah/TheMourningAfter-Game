[node name="Content" type="VBoxContainer" parent="NightModal/Panel"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="NightModal/Panel/Content"]
theme_override_fonts/font = ExtResource("f_title")
