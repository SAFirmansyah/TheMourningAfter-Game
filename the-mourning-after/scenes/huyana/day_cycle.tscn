horizontal_alignment = 1
vertical_alignment = 1

[node name="Note" type="Label" parent="NightModal/Panel/Content"]
visible = false
custom_minimum_size = Vector2(780, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.24, 0.15, 0.09, 1)
theme_override_font_sizes/font_size = 23
